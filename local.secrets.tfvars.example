# Copy to local.secrets.tfvars (gitignored) and fill real values.
#   cp local.secrets.tfvars.example local.secrets.tfvars

cloudflare_api_token = "cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
account_id           = "0123456789abcdef0123456789abcdef"
team_name            = "your-team" # → https://your-team.cloudflareaccess.com

gateway_public_hostname = "victron.example.com"
access_app_name         = "victron-gateway"
allow_emails            = ["you@example.com"]

service_token_name     = "inverter-desktop"
service_token_duration = "forever"

# Optional: store next to Access secrets for desktop remote profile
gateway_api_token = "replace-with-GATEWAY_API_TOKEN-from-inverter-gateway-.env"

# Optional tunnel JWT enforce via Terraform (OFF by default — see README)
manage_tunnel_config = false
tunnel_id            = "00000000-0000-0000-0000-000000000000"
tunnel_origin_service = "http://127.0.0.1:9150"
